    {
      "shortcut": "cte",
      "name": "Common Table Expression",
      "description": "CTE template",
      "category": "Query",
      "body": [
        "WITH ${1:CteName} AS (",
        "    ${2:SELECT * FROM dbo.TableName}",
        ")",
        "SELECT *",
        "FROM ${1:CteName};"
      ],
      "placeholders": {
        "1": { "default": "CteName", "description": "CTE name" },
        "2": { "default": "SELECT * FROM dbo.TableName", "description": "CTE query" }
      }
    },
    {
      "shortcut": "tryc",
      "name": "TRY/CATCH",
      "description": "TRY CATCH error handling block",
      "category": "Flow",
      "body": [
        "BEGIN TRY",
        "    ${1:-- your statement}",
        "END TRY",
        "BEGIN CATCH",
        "    SELECT ERROR_NUMBER() AS ErrorNumber, ERROR_MESSAGE() AS ErrorMessage;",
        "END CATCH;"
      ],
      "placeholders": {
        "1": { "default": "-- your statement", "description": "Protected statement" }
      }
